# RASP configuration — copy to .env and fill in anything you need.
# Everything works without these values.

# Optional: OpenRouter for AI headline suggestions (the app works fully without it)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Ports (defaults: 8000 backend, 5173 frontend)
# RASP_BACKEND_PORT=8000
# RASP_FRONTEND_PORT=5173
